# Copia este archivo como ".env" (sin el ".example") y completa los valores reales.
# El archivo ".env" NUNCA se sube a Git (ya está en .gitignore).

# --- Base de datos ---
# Ruta del archivo SQLite. En producción, asegúrate que "data/" sea un disco persistente.
DATABASE_PATH=data/reservas.db

# --- Mercado Pago ---
# Credenciales de prueba (sandbox): https://www.mercadopago.cl -> Tu negocio -> Credenciales
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública de tu sitio (sin barra al final). Mercado Pago la usa para redirigir
# de vuelta al cliente y para enviar la notificación de pago (webhook).
# En desarrollo local puedes usar una URL de ngrok/localtunnel; Mercado Pago necesita
# una URL accesible desde internet para el webhook, "localhost" no funciona.
PUBLIC_SITE_URL=http://localhost:5173

# --- Correo (Resend) ---
# Crea una cuenta gratis en https://resend.com y genera una API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Correo remitente. Con el dominio de prueba de Resend usa: onboarding@resend.dev
# Cuando verifiques tu propio dominio, cámbialo por algo como reservas@luzdecuarzo.cl
EMAIL_REMITENTE=onboarding@resend.dev
# Correo del negocio que también recibe copia de cada reserva
EMAIL_DUEÑA=sebav854@gmail.com

# --- WhatsApp (API oficial de Meta / WhatsApp Business Cloud API) ---
WHATSAPP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
# Número de la dueña en formato internacional SIN "+" ni espacios, ej: 56912345678
WHATSAPP_NUMERO_DUEÑA=56900000000
# Nombre exacto de la plantilla de mensaje aprobada en Meta Business Manager
WHATSAPP_PLANTILLA_NOMBRE=nueva_reserva

# --- Panel de administrador (/admin) ---
# Contraseña única para que la dueña entre a /admin. Usa algo largo y que no uses en otro lado.
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga-y-única

# Secreto usado para firmar la cookie de sesión del panel. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si lo dejas vacío, se usa ADMIN_PASSWORD como respaldo, pero es mejor tener uno aparte.
SESSION_SECRET=
